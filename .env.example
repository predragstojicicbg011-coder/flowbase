# Kopiraj u .env i popuni vrijednostima.
# Create React App ucitava SAMO promjenljive sa REACT_APP_ prefiksom, i SVE
# sto ima taj prefiks zavrsi u javnom JS bundle-u. Ovdje smiju samo vrijednosti
# koje su ionako javne.

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# NAPOMENA: EXCHANGE_API_KEY vise NE ide ovdje.
# Kljuc za exchangerate-api.com zivi na serveru, u Supabase secrets:
#
#     npx supabase secrets set EXCHANGE_API_KEY=<kljuc>
#
# Cita ga Edge Function supabase/functions/exchange-rate, koju frontend zove
# umjesto da sam nosi kljuc.
